{
  "area": "moving",
  "note": "ref = the left operand at the close of bar i - N; the service sends null when i - N < 0.",
  "cases": [
    {
      "name": "closes 100, 102, forming tick 105, N = 2, 5 % -> true",
      "spec": {
        "schemaVersion": 1,
        "left": {
          "kind": "price",
          "field": "close"
        },
        "condition": {
          "op": "movingUpPercent",
          "amount": 5,
          "bars": 2
        },
        "trigger": "everyTime"
      },
      "samples": [
        {
          "kind": "close",
          "barIndex": 0,
          "barTime": 0,
          "now": 0,
          "values": {
            "x": 100,
            "ref": null,
            "open": 100,
            "high": 100,
            "low": 100,
            "close": 100,
            "volume": 0
          }
        },
        {
          "kind": "close",
          "barIndex": 1,
          "barTime": 60,
          "now": 60000,
          "values": {
            "x": 102,
            "ref": null,
            "open": 102,
            "high": 102,
            "low": 102,
            "close": 102,
            "volume": 0
          }
        },
        {
          "kind": "tick",
          "barIndex": 2,
          "barTime": 120,
          "now": 120000,
          "values": {
            "x": 105,
            "ref": 100,
            "open": 105,
            "high": 105,
            "low": 105,
            "close": 105,
            "volume": 0
          }
        }
      ],
      "expect": [2]
    },
