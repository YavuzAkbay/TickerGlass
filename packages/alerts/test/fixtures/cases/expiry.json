{
  "area": "expiry",
  "cases": [
    {
      "name": "sample at expiresAt is not evaluated",
      "spec": {
        "schemaVersion": 1,
        "left": {
          "kind": "price",
          "field": "close"
        },
        "condition": {
          "op": "greater",
          "right": {
            "kind": "value",
            "value": 10
          }
        },
        "trigger": "everyTime"
      },
      "alert": {
        "expiresAt": "1970-01-01T00:02:00Z"
      },
      "samples": [
        {
          "kind": "tick",
          "barIndex": 0,
          "barTime": 0,
          "now": 0,
          "values": {
            "x": 11,
            "y": 10,
            "open": 11,
            "high": 11,
            "low": 11,
            "close": 11,
            "volume": 0
          }
        },
        {
          "kind": "tick",
          "barIndex": 1,
          "barTime": 60,
          "now": 60000,
          "values": {
            "x": 11,
            "y": 10,
            "open": 11,
            "high": 11,
            "low": 11,
            "close": 11,
            "volume": 0
          }
        },
        {
          "kind": "tick",
          "barIndex": 2,
          "barTime": 120,
          "now": 120000,
          "values": {
            "x": 11,
            "y": 10,
            "open": 11,
            "high": 11,
            "low": 11,
            "close": 11,
            "volume": 0
          }
        }
      ],
      "expect": [0, 1]
    },
    {
      "name": "an expired sample does not become prev",
      "spec": {
        "schemaVersion": 1,
        "left": {
          "kind": "price",
          "field": "close"
        },
        "condition": {
          "op": "crossingUp",
          "right": {
            "kind": "value",
            "value": 10
          }
        },
        "trigger": "everyTime"
      },
      "alert": {
        "expiresAt": "1970-01-01T00:02:00Z"
      },
      "samples": [
        {
          "kind": "tick",
          "barIndex": 0,
          "barTime": 0,
          "now": 60000,
          "values": {
            "x": 9,
            "y": 10,
            "open": 9,
            "high": 9,
            "low": 9,
            "close": 9,
            "volume": 0
          }
        },
        {
          "kind": "tick",
          "barIndex": 1,
          "barTime": 60,
          "now": 120000,
          "values": {
            "x": 11,
            "y": 10,
            "open": 11,
            "high": 11,
            "low": 11,
            "close": 11,
            "volume": 0
          }
        }
      ],
      "expect": []
    }
  ]
}
