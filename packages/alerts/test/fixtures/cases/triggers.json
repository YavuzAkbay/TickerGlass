{
  "area": "trigger modes",
  "cases": [
    {
      "name": "oncePerBar: true ticks t1, t2 in bar A, t3 in bar B fire at t1 and t3",
      "spec": {
        "schemaVersion": 1,
        "left": {
          "kind": "price",
          "field": "close"
        },
        "condition": {
          "op": "greater",
          "right": {
            "kind": "value",
            "value": 10
          }
        },
        "trigger": "oncePerBar"
      },
      "samples": [
        {
          "kind": "tick",
          "barIndex": 0,
          "barTime": 0,
          "now": 1000,
          "values": {
            "x": 11,
            "y": 10,
            "open": 11,
            "high": 11,
            "low": 11,
            "close": 11,
            "volume": 0
          }
        },
        {
          "kind": "tick",
          "barIndex": 0,
          "barTime": 0,
          "now": 2000,
          "values": {
            "x": 12,
            "y": 10,
            "open": 12,
            "high": 12,
            "low": 12,
            "close": 12,
            "volume": 0
          }
        },
        {
          "kind": "tick",
          "barIndex": 1,
          "barTime": 60,
          "now": 61000,
          "values": {
            "x": 13,
            "y": 10,
            "open": 13,
            "high": 13,
            "low": 13,
            "close": 13,
            "volume": 0
          }
        }
      ],
      "expect": [0, 2]
    },
