WEB_PORT=8080
API_PORT=8000

# Default storage is SQLite inside the api-data volume.
# To use Postgres: start with `docker compose --profile postgres up` and uncomment:
# DATABASE_URL=postgresql+psycopg://tickerglass:${POSTGRES_PASSWORD}@postgres:5432/tickerglass
POSTGRES_PASSWORD=change-me-for-shared-hosts

# Market data source: yahoo (default, via yfinance), twelvedata (Twelve Data API, needs a key) or
# demo (generated offline prices, no network; for trying the app, screenshots and tests).
# See docs/providers.md. Switching provider clears the cached market data (your data is kept).
# MARKET_PROVIDER=yahoo
# The app can switch the provider at runtime (Settings, Data source); the choice is kept across
# restarts until MARKET_PROVIDER is changed. false locks the provider to MARKET_PROVIDER.
# PROVIDER_SWITCHING=true
# Minimum seconds between two switches to different providers.
# PROVIDER_SWITCH_COOLDOWN_S=10

# Twelve Data (MARKET_PROVIDER=twelvedata). The key is only ever sent in a request header.
# TWELVEDATA_API_KEY=
# Your subscription: basic (default: 8 credits/min, 800/day, US stocks, forex, crypto), grow, pro,
# ultra or enterprise. The app paces its requests to the plan's credits.
# TWELVEDATA_PLAN=basic
# Optional overrides of what the plan implies (leave unset to follow the plan):
# TWELVEDATA_CREDITS_PER_MIN=
# Daily credit cap; 0 removes it.
# TWELVEDATA_DAILY_CREDITS=
# TWELVEDATA_EXTENDED_HOURS=
# TWELVEDATA_EVENTS=
# TWELVEDATA_FUNDAMENTALS=
# TWELVEDATA_INTERNATIONAL=
# Seconds between quote polls of a symbol.
# TWELVEDATA_POLL_INTERVAL_S=

# Alerts (docs/alerts.md section 4.1). All optional; secrets stay on the server.
# Default webhook target (a per-alert webhook URL overrides it) and an HMAC-SHA256 signing secret
# (sent as X-TickerGlass-Signature: sha256=<hex>).
# ALERTS_WEBHOOK_URL=
# ALERTS_WEBHOOK_SECRET=
# Per-alert webhook URLs may not point at loopback/private/link-local addresses (SSRF guard)
# unless this is true. ALERTS_WEBHOOK_URL is operator-set and exempt.
# ALERTS_WEBHOOK_ALLOW_PRIVATE=false
# Telegram needs both.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Email needs SMTP_HOST, SMTP_FROM and SMTP_TO (comma list allowed). SMTP_TLS: starttls | ssl | none.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TO=
# SMTP_TLS=starttls
# Newest N fired-alert log entries kept.
# ALERTS_LOG_MAX=5000
# When set, the alerts service must send it as X-Alerts-Token on its write routes.
# ALERTS_INTERNAL_TOKEN=
